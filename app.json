{
  "expo": {
    "name": "Social",
    "slug": "social",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "scheme": "social",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techusic.social"
    },
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.techusic.social"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-image",
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "llama.rn",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Social to access your photos so you can attach them to posts.",
          "cameraPermission": "Allow Social to use your camera so you can attach photos to posts.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
